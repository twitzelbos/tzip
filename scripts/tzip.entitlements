<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required so OSSystemExtensionManager accepts the tzip binary as
       the host that is requesting the extension activation. Even ad-hoc
       signed binaries need the entitlement declared; the OS otherwise
       refuses the request with error code 2 ("Missing entitlement"). -->
  <key>com.apple.developer.system-extension.install</key>
  <true/>
</dict>
</plist>
